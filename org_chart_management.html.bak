  <!-- Deputy -->
  <div style="margin-top:6px;margin-left:calc(175px + 4px);position:relative">
    <div style="position:absolute;left:-20px;top:-6px;width:1px;height:calc(100% + 12px);background:var(--color-border-secondary)"></div>
    <div style="position:absolute;left:-20px;top:50%;width:20px;height:1px;background:var(--color-border-secondary)"></div>
    <div class="oc-card lv-deputy" style="max-width:calc(175px - 4px)" onclick="toggle(this)">
      <div class="oc-top">
        <div class="oc-avatar av-deputy" style="width:28px;height:28px;font-size:10px">РТ</div>
        <div>
          <div class="oc-name" style="font-size:11px">Raxmatullayev To'lqinjon</div>
          <div class="oc-role">Заместитель начальника</div>
          <div class="oc-dept">Кассовые решения</div>
        </div>
      </div>
      <div class="oc-contacts">
        <div class="oc-contact-row"><i class="ti ti-brand-telegram" aria-hidden="true"></i>@rTulkin</div>
        <div class="oc-contact-row"><i class="ti ti-phone" aria-hidden="true"></i>+998 97 705 42 93</div>
      </div>
      <div class="oc-hint">нажмите для контактов</div>
    </div>
  </div>

</div>

<script>
function toggle(card){
  const c=card.querySelector('.oc-contacts');
  const h=card.querySelector('.oc-hint');
  if(!c)return;
  const open=c.classList.toggle('open');
  if(h)h.textContent=open?'скрыть контакты':'нажмите для контактов';
}
</script>
