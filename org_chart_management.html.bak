
<h2 class="sr-only">Организационная структура руководства компании</h2>

<style>
.oc-wrap{padding:1.5rem 0 2rem;font-family:var(--font-sans)}
.oc-section-label{text-align:center;font-size:11px;color:var(--color-text-tertiary);letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;display:flex;align-items:center;gap:10px}
.oc-section-label::before,.oc-section-label::after{content:'';flex:1;height:1px;background:var(--color-border-tertiary)}
.oc-connector{width:2px;height:24px;background:var(--color-border-secondary);margin:0 auto}
.oc-card{background:var(--color-background-primary);border:0.5px solid var(--color-border-tertiary);border-radius:var(--border-radius-lg);padding:12px 14px;cursor:pointer;transition:border-color .15s;position:relative;overflow:hidden;text-align:left;display:flex;flex-direction:column;gap:6px}
.oc-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px}
.oc-card:hover{border-color:var(--color-border-secondary)}
.oc-card.lv-director::before{background:#EF9F27}
.oc-card.lv-csuite::before{background:#378ADD}
.oc-card.lv-admin::before{background:#1D9E75}
.oc-card.lv-head::before{background:#7F77DD}
.oc-card.lv-deputy::before{background:#888780}
.oc-card.lv-consult::before{background:#D85A30}
.oc-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500;flex-shrink:0}
.oc-avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover;object-position:center top}
.av-director{background:#FAEEDA;color:#633806}
.av-csuite{background:#E6F1FB;color:#0C447C}
.av-admin{background:#E1F5EE;color:#085041}
.av-head{background:#EEEDFE;color:#3C3489}
.av-deputy{background:#F1EFE8;color:#5F5E5A}
.av-consult{background:#FAECE7;color:#712B13}
.oc-top{display:flex;align-items:center;gap:10px}
.oc-name{font-size:13px;font-weight:500;color:var(--color-text-primary);line-height:1.3}
.oc-role{font-size:11px;color:var(--color-text-secondary);line-height:1.4}
.oc-dept{font-size:10px;color:var(--color-text-tertiary);margin-top:2px}
.oc-desc{font-size:11px;color:var(--color-text-tertiary);line-height:1.4;border-top:0.5px solid var(--color-border-tertiary);padding-top:6px}
.oc-contacts{display:none;border-top:0.5px solid var(--color-border-tertiary);padding-top:8px;gap:6px;flex-direction:column}
.oc-contacts.open{display:flex}
.oc-contact-row{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--color-text-secondary)}
.oc-contact-row i{font-size:14px;color:var(--color-text-tertiary)}
.oc-hint{font-size:10px;color:var(--color-text-tertiary);margin-top:4px;text-align:right}
.oc-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.oc-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.oc-grid-auto{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:8px}
.oc-sub-row{display:flex;gap:8px;margin-top:8px;margin-left:24px;position:relative}
.oc-sub-row::before{content:'';position:absolute;left:-16px;top:-8px;width:1px;height:calc(100% + 8px);background:var(--color-border-secondary)}
.oc-sub-row::after{content:'';position:absolute;left:-16px;top:50%;width:16px;height:1px;background:var(--color-border-secondary);transform:translateY(-50%)}
@media(max-width:520px){.oc-grid-3{grid-template-columns:1fr}.oc-grid-2{grid-template-columns:1fr}}
</style>

<div class="oc-wrap">

